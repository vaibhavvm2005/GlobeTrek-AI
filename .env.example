# GlobeTrek AI – Environment Configuration
# Copy this file to .env and fill in your values.

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-secret-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database
# For MySQL:   mysql+pymysql://user:password@localhost:3306/globetrek_db
# For SQLite (default demo): sqlite:///globetrek.db
DATABASE_URL=sqlite:///globetrek.db

# Razorpay (test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini AI
GEMINI_API_KEY=

# Flask-Mail (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@globetrek.ai

# Google Maps (optional – falls back to OpenStreetMap)
GOOGLE_MAPS_API_KEY=

# Ticket signing secret (HMAC-SHA256)
TICKET_SIGNING_SECRET=change-me-to-a-random-hex-string
